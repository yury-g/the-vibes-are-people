{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Vibes Ingredients proposal v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "person",
    "target",
    "kind",
    "role",
    "claim",
    "sources"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "person": {
      "type": "string",
      "minLength": 2,
      "maxLength": 100
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "name"
      ],
      "properties": {
        "type": {
          "enum": [
            "recipe",
            "institution",
            "language",
            "tool"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      }
    },
    "kind": {
      "enum": [
        "contribution",
        "residency",
        "teaching",
        "education",
        "funding",
        "exhibition",
        "language/tool"
      ]
    },
    "role": {
      "type": "string",
      "minLength": 2,
      "maxLength": 100
    },
    "claim": {
      "type": "string",
      "minLength": 20,
      "maxLength": 1200
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "uri",
        "pattern": "^https://",
        "maxLength": 800
      }
    }
  }
}
